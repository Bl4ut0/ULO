package-as: ULO
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

move-folders:
  ULO/ULO: ULO

ignore:
  - .agents
  - .github
  - .tools
  - .versions
  - AGENTS.md
  - docs
  - Images
  - node_modules
  - package.json
  - package-lock.json
  - README.md
  - RunTests.bat
  - RunTests.ps1
  - Tests
